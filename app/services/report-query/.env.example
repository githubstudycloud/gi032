# 复制为 .env 后改成本机值
# === 数据库 ===
# MySQL 5.7（团队主推）
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/report?charset=utf8mb4
# MySQL 8.0（兼容）
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/report?charset=utf8mb4
# PostgreSQL
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/report
# SQLite（dev 默认）
DATABASE_URL=sqlite:///./report_query.db
DATABASE_ECHO=false

# === 服务 ===
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO

# === CORS ===
# 多个用 JSON list：CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
