# Monorepo 部署环境变量样例（复制为 .env 后改）
#
# docker-compose.yml 自动读 .env；本地 dev 不需要这个文件，每个 service 自带 .env

# 服务器 IP（CORS / 文档链接里用到）
SERVER_HOST=192.168.0.132

# 容器端口（host 上对外）
WEB_PORT=80
MYSQL_PORT=3306

# MySQL 凭据 —— 生产**务必**改成强密码
MYSQL_ROOT_PASSWORD=root_pwd_change_me
MYSQL_DATABASE=report
MYSQL_USER=report_user
MYSQL_PASSWORD=report_pwd_change_me

# 生成服务 admin 鉴权 token（写路径 / ingest 必带）
ADMIN_TOKEN=

# 镜像 tag
TAG=latest
