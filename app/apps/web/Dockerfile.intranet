# 前端镜像（内网版本）—— 多阶段：Node 24 构建 → Nginx 静态服务
#
# 适用场景：内网 harbor 已有 node:24 + nginx:alpine 镜像，
#   但**没有 alpine apk 源 / 也没有 debian apt 源镜像**。
#
# 与 Dockerfile 的差异：
#   - build 阶段走 node:24（debian-bookworm），不依赖 apk
#   - runtime 阶段 nginx:alpine 不跑任何 `apk` 命令（依赖 busybox 内置工具）
#   - 全程只有 pnpm install 需要联网 → 用内网 npm registry 即可
#
# 构建：docker build -f apps/web/Dockerfile.intranet -t ops-web:dev apps/web
#
# 构建参数：
#   BASE_NODE     默认 node:24（debian-bookworm）
#                 内网示例：harbor.intra.corp/library/node:24
#   BASE_NGINX    默认 nginx:alpine
#                 内网示例：harbor.intra.corp/library/nginx:alpine
#   NPM_REGISTRY  默认 https://registry.npmmirror.com（淘宝）
#                 内网示例：http://nexus.intra.corp/repository/npm-group/
#   NUXT_PUBLIC_DATA_SOURCE_MODE api | json
#   NUXT_PUBLIC_API_BASE
#   NUXT_PUBLIC_MOCK_BASE
#
# 内网一把梭示例：
#   docker build apps/web -f apps/web/Dockerfile.intranet \
#     --build-arg BASE_NODE=harbor.intra.corp/library/node:24 \
#     --build-arg BASE_NGINX=harbor.intra.corp/library/nginx:alpine \
#     --build-arg NPM_REGISTRY=http://nexus.intra.corp/repository/npm-group/ \
#     -t ops-web:dev

# 全局 ARG —— 必须在所有 FROM 之前声明，否则后续 stage 的 FROM 看不到它。
# 每个 stage 内还需要重新 `ARG` 一次才能在 RUN/ENV 里展开（这里只在 FROM 用，无需重声明）。
ARG BASE_NODE=node:24
ARG BASE_NGINX=nginx:alpine

# ---------- stage 1：Node 24 构建（debian-based，不需要 apk）----------
FROM ${BASE_NODE} AS build

ARG NPM_REGISTRY=https://registry.npmmirror.com

# COREPACK_NPM_REGISTRY 必须显式设置：
#   corepack 有自己的 registry 配置，不读 NPM_CONFIG_REGISTRY / .npmrc，
#   默认走 https://registry.npmjs.org —— 内网会卡在这里超时。
ENV PNPM_HOME=/pnpm \
    PATH="/pnpm:$PATH" \
    NPM_CONFIG_REGISTRY=${NPM_REGISTRY} \
    COREPACK_NPM_REGISTRY=${NPM_REGISTRY}

RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

# pnpm registry（三保险 —— corepack 已走 COREPACK_NPM_REGISTRY 装 pnpm，
# pnpm 运行时再读这里写到 ~/.npmrc）
RUN pnpm config set registry "${NPM_REGISTRY}"

WORKDIR /app

# 利用缓存：先 lock + package，再 install
COPY package.json pnpm-lock.yaml ./
COPY .nvmrc ./
RUN pnpm install --frozen-lockfile

COPY . .

# 数据源模式 baked into bundle（SSG 后无法改）。
#   api  → 走真后端（默认，部署版）
#   json → 读 /mock/*.json（调试 / 离线 demo）
ARG NUXT_PUBLIC_DATA_SOURCE_MODE=api
ARG NUXT_PUBLIC_API_BASE=/api
ARG NUXT_PUBLIC_MOCK_BASE=/mock
ENV NUXT_PUBLIC_DATA_SOURCE_MODE=${NUXT_PUBLIC_DATA_SOURCE_MODE} \
    NUXT_PUBLIC_API_BASE=${NUXT_PUBLIC_API_BASE} \
    NUXT_PUBLIC_MOCK_BASE=${NUXT_PUBLIC_MOCK_BASE}

# generate = SSG 静态站；输出在 .output/public
RUN pnpm generate

# ---------- stage 2：Nginx 静态服务（alpine 镜像直接用，不跑 apk）----------
FROM ${BASE_NGINX}

COPY --from=build /app/.output/public /usr/share/nginx/html
COPY ./infra/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
# busybox wget 在 nginx:alpine 里默认就有，无需 apk add
HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD wget -q --spider http://127.0.0.1/healthz || exit 1
