# 前端镜像（离线/独立版本）—— frontend-only，零后端依赖
#
# 适用场景：
#   - 还没部署 report-query / report-generation 时先发前端
#   - 演示 / 测试环境
#   - 内网纯静态展示
#
# 数据来源：public/mock/*.json（已随 SSG 产物拷到 nginx root 下）
#
# 与 Dockerfile.intranet 的差异：
#   - NUXT_PUBLIC_DATA_SOURCE_MODE 默认 json（不再调 /api）
#   - 用 infra/nginx.offline.conf —— 删了 /api/ 反代（不会 502）
#   - 其他（基镜像 / npm 装 pnpm / TLS 全关）跟 intranet 一致
#
# 构建：
#   docker build -f apps/web/Dockerfile.offline -t ops-web-offline:dev apps/web
#
# 内网一把梭示例：
#   docker build apps/web -f apps/web/Dockerfile.offline \
#     --build-arg BASE_NODE=harbor.intra.corp/library/node:24 \
#     --build-arg BASE_NGINX=harbor.intra.corp/library/nginx:alpine \
#     --build-arg NPM_REGISTRY=https://nexus.intra.corp/repository/npm-group/ \
#     -t ops-web-offline:dev

# 全局 ARG —— 必须在所有 FROM 之前声明
ARG BASE_NODE=node:24
ARG BASE_NGINX=nginx:alpine

# ---------- stage 1：Node 24 构建（debian-based，不需要 apk）----------
FROM ${BASE_NODE} AS build

ARG NPM_REGISTRY=https://registry.npmmirror.com

# 全内网 TLS 关掉（自签 / 内部 CA），只在 build stage 生效
ENV NPM_CONFIG_REGISTRY=${NPM_REGISTRY} \
    NODE_TLS_REJECT_UNAUTHORIZED=0 \
    NPM_CONFIG_STRICT_SSL=false

# 直接用 npm 装 pnpm（绕开 corepack）—— corepack tarball 路径跟 nexus 不兼容
RUN npm install -g pnpm@9.12.0 --registry="${NPM_REGISTRY}"
RUN pnpm config set registry "${NPM_REGISTRY}"

WORKDIR /app

# 利用缓存：先 lock + package，再 install
COPY package.json pnpm-lock.yaml ./
COPY .nvmrc ./
RUN pnpm install --frozen-lockfile

COPY . .

# 关键差异：默认 json 模式，bundle 里写死走 /mock/*.json
#
# NUXT_APP_BASE_URL：挂在外层 nginx 子路径下时必须设置（带斜杠），
#   例：--build-arg NUXT_APP_BASE_URL=/webService/
#   同时 MOCK_BASE / API_BASE 也要带前缀（NUXT_APP_BASE_URL 只影响 Nuxt 自身的资源 URL，
#   runtimeConfig.public.* 不会自动加前缀，要手动带）。
ARG NUXT_APP_BASE_URL=/
ARG NUXT_PUBLIC_DATA_SOURCE_MODE=json
ARG NUXT_PUBLIC_API_BASE=/api
ARG NUXT_PUBLIC_MOCK_BASE=/mock
ENV NUXT_APP_BASE_URL=${NUXT_APP_BASE_URL} \
    NUXT_PUBLIC_DATA_SOURCE_MODE=${NUXT_PUBLIC_DATA_SOURCE_MODE} \
    NUXT_PUBLIC_API_BASE=${NUXT_PUBLIC_API_BASE} \
    NUXT_PUBLIC_MOCK_BASE=${NUXT_PUBLIC_MOCK_BASE}

# generate = SSG 静态站；输出在 .output/public（包含 public/mock/*.json）
RUN pnpm generate

# ---------- stage 2：Nginx 静态服务（用 offline 版配置）----------
FROM ${BASE_NGINX}

COPY --from=build /app/.output/public /usr/share/nginx/html
COPY ./infra/nginx.offline.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
# busybox wget 在 nginx:alpine 里默认就有，无需 apk add
HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD wget -q --spider http://127.0.0.1/healthz || exit 1
