{
  "meta": {
    "report_type": "exec",
    "name": "AI辅助测试执行",
    "subtitle": "各部门 AI 测试执行渗透率排行",
    "version": 1,
    "user_pref_endpoint": "/api/users/me/columns/exec"
  },

  "toolbar": { "show_refresh": true },

  "filters": [
    { "code": "time_range", "label": "时间范围", "kind": "flat_dropdown", "required": true,
      "param": { "value": "time_range" }, "default": { "value": "7d" },
      "source": { "endpoint": "/dropdowns/time-ranges", "params_in": ["q"] } },
    { "code": "department", "label": "领域", "kind": "flat_dropdown",
      "param": { "value": "department_code" }, "default": { "value": "all" },
      "source": { "endpoint": "/dropdowns/departments", "params_in": ["q", "page"], "supports_favorite": true } }
  ],

  "kpi": {
    "enabled": true,
    "title": "核心指标",
    "data_endpoint": "/api/reports/exec/kpi",
    "layout_mode_default": "grouped",
    "footnote": "点击卡片可查看明细数字。",
    "groups": [
      { "key": "user", "label": "用户指标", "items": [
        { "key": "ai-user-count", "label": "AI用户数", "data_type": "int",
          "description": "本月使用过 AI 测试执行功能的活跃用户数。" }
      ]},
      { "key": "business", "label": "业务指标", "items": [
        { "key": "ai-requirements",    "label": "AI执行需求数", "data_type": "int",
          "description": "本月接入 AI 测试执行的需求总数。" },
        { "key": "total-requirements", "label": "需求数",   "data_type": "int",
          "description": "本月所有进入测试环节的需求总数。" },
        { "key": "design-coverage",    "label": "AI测试执行渗透率", "unit": "%", "data_type": "percent",
          "description": "公式：AI 执行需求数 ÷ 需求数 × 100%。\n参考阈值：≥ 55% 为达标。",
          "threshold": { "min": 55, "goodColor": "emerald", "badColor": "rose" } },
        { "key": "valid-ai-cases",     "label": "AI执行通过用例数", "data_type": "int",
          "description": "AI 自动执行且通过的用例总数。" },
        { "key": "total-cases",        "label": "执行用例数", "data_type": "int",
          "description": "本月所有被执行的测试用例总数。" },
        { "key": "ai-case-ratio",      "label": "AI执行用例占比", "unit": "%", "data_type": "percent",
          "description": "AI 自动执行用例数 / 执行用例总数。",
          "threshold": { "min": 50, "goodColor": "emerald", "badColor": "amber" } },
        { "key": "ai-defect-ratio",    "label": "AI执行发现缺陷占比", "unit": "%", "data_type": "percent",
          "description": "AI 执行用例发现缺陷数 / 全部用例发现缺陷数。" }
      ]},
      { "key": "capability", "label": "能力指标", "items": [
        { "key": "ai-cases-generated", "label": "AI执行总次数", "data_type": "int",
          "description": "AI 本月触发执行的总次数（含失败重跑）。" },
        { "key": "ai-cases-adopted",   "label": "AI执行成功次数", "data_type": "int",
          "description": "AI 执行且首次通过的次数。" },
        { "key": "adoption-rate",      "label": "AI执行成功率", "unit": "%", "data_type": "percent",
          "description": "公式：AI 执行成功次数 ÷ AI 执行总次数。",
          "threshold": { "min": 75, "goodColor": "emerald", "badColor": "rose" } },
        { "key": "avg-interactions",   "label": "平均每用例执行轮次", "data_type": "decimal",
          "description": "每个用例的 AI 平均执行轮数（含重跑）。" }
      ]}
    ]
  },

  "primary_view": {
    "enabled": true,
    "title": "AI辅助测试执行明细",
    "endpoint": "/api/reports/exec/summary",
    "method": "POST",
    "paging": { "default_mode": "client", "default_page_size": 10 },
    "tabs": [
      {
        "key": "exec-detail",
        "label": "AI辅助测试执行明细",
        "data_endpoint": "/api/reports/exec/summary?tab=exec-detail",
        "header_tree": [
          { "key": "rank",          "label": "排名",         "width": "70px",  "sortable": true },
          { "key": "department",    "label": "部门",         "width": "200px", "filterable": true, "align": "left" },
          { "key": "req-total",     "label": "需求总数",     "sortable": true },
          { "key": "ai-req-count",  "label": "Ai执行需求数", "sortable": true },
          { "key": "coverage",      "label": "执行渗透率",   "sortable": true, "highlight": true,
            "threshold": { "min": 55, "goodColor": "emerald", "badColor": "rose" } },
          { "key": "ai-cases",      "label": "Ai执行用例数", "sortable": true },
          { "key": "adopted-cases", "label": "执行通过数",   "sortable": true },
          { "key": "adoption-rate", "label": "通过率",       "sortable": true, "highlight": true,
            "threshold": { "min": 75, "goodColor": "emerald", "badColor": "amber" } },
          { "key": "defects",       "label": "发现缺陷数",   "sortable": true },
          { "key": "actions",       "label": "操作",         "width": "90px", "cellType": "action" }
        ]
      }
    ]
  },

  "drilldowns": {}
}
