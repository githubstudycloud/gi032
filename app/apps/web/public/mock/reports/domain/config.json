{
  "meta": {
    "report_type": "domain",
    "name": "领域落地进展",
    "subtitle": "六大领域 AI 测试覆盖明细",
    "version": 1,
    "user_pref_endpoint": "/api/users/me/columns/domain"
  },

  "toolbar": { "show_refresh": true },

  "filters": [
    { "code": "time_range", "label": "时间范围", "kind": "flat_dropdown", "required": true,
      "param": { "value": "time_range" }, "default": { "value": "7d" },
      "source": { "endpoint": "/dropdowns/time-ranges", "params_in": ["q"] } },
    { "code": "department", "label": "项目", "kind": "flat_dropdown",
      "param": { "value": "department_code" }, "default": { "value": "all" },
      "source": { "endpoint": "/dropdowns/departments", "params_in": ["q", "page"], "supports_favorite": true } }
  ],

  "kpi": {
    "enabled": true,
    "title": "核心指标",
    "data_endpoint": "/api/reports/domain/kpi",
    "layout_mode_default": "grouped",
    "footnote": "点击卡片可查看明细数字。",
    "groups": [
      { "key": "user", "label": "用户指标", "items": [
        { "key": "ai-user-count", "label": "AI用户数", "data_type": "int",
          "description": "本月使用过 AI 测试运营任意功能的活跃用户数。" }
      ]},
      { "key": "business", "label": "业务指标", "items": [
        { "key": "ai-requirements",    "label": "AI需求数", "data_type": "int",
          "description": "本月接入 AI 测试设计 / 脚本生成的需求总数。" },
        { "key": "total-requirements", "label": "需求数",   "data_type": "int",
          "description": "本月所有进入测试环节的需求总数。" },
        { "key": "design-coverage",    "label": "AI测试设计需求覆盖率", "unit": "%", "data_type": "percent",
          "description": "公式：AI 需求数 ÷ 需求数 × 100%。",
          "threshold": { "min": 60, "goodColor": "emerald", "badColor": "rose" } },
        { "key": "valid-ai-cases",     "label": "AI生成的有效用例数", "data_type": "int",
          "description": "AI 生成且被采纳的用例总数。" },
        { "key": "total-cases",        "label": "用例数", "data_type": "int",
          "description": "本月新增的测试用例总数。" },
        { "key": "ai-case-ratio",      "label": "AI生成测试用例占比", "unit": "%", "data_type": "percent",
          "description": "AI 生成有效用例数 ÷ 用例总数。",
          "threshold": { "min": 50, "goodColor": "emerald", "badColor": "amber" } },
        { "key": "ai-defect-ratio",    "label": "AI生成用例发现缺陷占比", "unit": "%", "data_type": "percent",
          "description": "AI 生成用例发现缺陷数 / 全部用例发现缺陷数。" }
      ]},
      { "key": "capability", "label": "能力指标", "items": [
        { "key": "ai-cases-generated", "label": "AI生成用例数", "data_type": "int",
          "description": "AI 系统本月生成的全部候选用例（含未采纳）。" },
        { "key": "ai-cases-adopted",   "label": "AI生成采纳用例数", "data_type": "int",
          "description": "AI 生成且落入正式用例库的数量。" },
        { "key": "adoption-rate",      "label": "AI生成用例采纳率", "unit": "%", "data_type": "percent",
          "description": "AI 采纳用例数 ÷ AI 生成用例数。",
          "threshold": { "min": 65, "goodColor": "emerald", "badColor": "rose" } },
        { "key": "avg-interactions",   "label": "平均每需求交互次数", "data_type": "decimal",
          "description": "每个需求的 AI 平均交互轮数。" }
      ]}
    ]
  },

  "primary_view": {
    "enabled": true,
    "title": "领域落地进展明细",
    "endpoint": "/api/reports/domain/summary",
    "method": "POST",
    "paging": { "default_mode": "client", "default_page_size": 10 },
    "row_dim_options": [ { "code": "domain", "label": "按领域 (默认)" } ],
    "row_dim_default": "domain",
    "tabs": [
      {
        "key": "domain-detail",
        "label": "领域落地进展明细",
        "data_endpoint": "/api/reports/domain/summary?tab=domain-detail",
        "header_tree": [
          { "key": "domain", "label": "领域", "width": "110px", "filterable": true },
          { "key": "design", "label": "测试设计", "children": [
            { "key": "design-req-total", "label": "需求个数" },
            { "key": "design-req-ai",    "label": "Ai需求个数" },
            { "key": "design-req-cov",   "label": "Ai涉及需求覆盖率", "sortable": true, "highlight": true,
              "threshold": { "min": 60, "goodColor": "emerald", "badColor": "rose" } },
            { "key": "design-case-new",  "label": "新增用例个数" }
          ]},
          { "key": "script", "label": "测试脚本生成", "children": [
            { "key": "script-ai-cases",    "label": "Ai用例个数" },
            { "key": "script-ai-ratio",    "label": "测试用例Ai生成占比" },
            { "key": "script-ai-adoption", "label": "Ai生成用例采纳率", "sortable": true,
              "threshold": { "min": 65, "goodColor": "emerald", "badColor": "rose" } }
          ]},
          { "key": "exec", "label": "测试执行", "children": [
            { "key": "exec-ai-code-ratio",    "label": "Ai生成脚本代码占比" },
            { "key": "exec-ai-code-lines",    "label": "Ai生成代码入库行数" },
            { "key": "exec-ai-code-accuracy", "label": "Ai生成代码准确率", "sortable": true,
              "threshold": { "min": 80, "goodColor": "emerald", "badColor": "amber" } }
          ]},
          { "key": "result", "label": "结果分析", "children": [
            { "key": "result-new-ai-ratio",      "label": "新增测试脚本Ai辅助生成占比" },
            { "key": "result-ai-exec-ratio",     "label": "Ai辅助测试执行比例" },
            { "key": "result-intent-accuracy",   "label": "测试执行任务意图识别准确率" },
            { "key": "result-auto-fail-count",   "label": "自动化失败需分析数" },
            { "key": "result-auto-fail-ai-rate", "label": "自动化失败Ai自主分析率(S级)" },
            { "key": "result-auto-fail-ai-acc",  "label": "自动化失败Ai自主分析准确率(S级)" }
          ]},
          { "key": "actions", "label": "操作", "width": "90px", "cellType": "action" }
        ]
      }
    ]
  },

  "drilldowns": {}
}
