{
  "meta": {
    "report_type": "codegen",
    "name": "AI辅助测试代码生成",
    "subtitle": "AI 代码生成在产业与领域的覆盖与质量",
    "version": 1,
    "user_pref_endpoint": "/api/users/me/columns/codegen"
  },

  "toolbar": { "show_refresh": true },

  "filters": [
    { "code": "time_range", "label": "时间范围", "kind": "flat_dropdown", "required": true,
      "param": { "value": "time_range" }, "default": { "value": "7d" },
      "source": { "endpoint": "/dropdowns/time-ranges", "params_in": ["q"] } },
    { "code": "department", "label": "项目", "kind": "flat_dropdown",
      "param": { "value": "department_code" }, "default": { "value": "all" },
      "source": { "endpoint": "/dropdowns/departments", "params_in": ["q", "page"], "supports_favorite": true } }
  ],

  "kpi": {
    "enabled": true,
    "title": "核心指标",
    "data_endpoint": "/api/reports/codegen/kpi",
    "layout_mode_default": "grouped",
    "footnote": "点击卡片可查看明细数字。",
    "groups": [
      { "key": "user", "label": "用户指标", "items": [
        { "key": "ai-user-count", "label": "AI用户数", "data_type": "int",
          "description": "本月使用过 AI 测试运营任意功能的活跃用户数。" }
      ]},
      { "key": "business", "label": "业务指标", "items": [
        { "key": "ai-requirements",    "label": "AI需求数", "data_type": "int",
          "description": "本月接入 AI 代码生成的需求总数。" },
        { "key": "total-requirements", "label": "需求数", "data_type": "int",
          "description": "本月所有进入测试环节的需求总数。" },
        { "key": "design-coverage",    "label": "AI测试设计需求覆盖率", "unit": "%", "data_type": "percent",
          "description": "公式：AI 需求数 ÷ 需求数 × 100%。",
          "threshold": { "min": 60, "goodColor": "emerald", "badColor": "rose" } },
        { "key": "valid-ai-cases",     "label": "AI生成的有效用例数", "data_type": "int",
          "description": "AI 生成且被采纳的用例总数。" },
        { "key": "total-cases",        "label": "用例数", "data_type": "int",
          "description": "本月新增的测试用例总数。" },
        { "key": "ai-case-ratio",      "label": "AI生成测试用例占比", "unit": "%", "data_type": "percent",
          "description": "AI 生成有效用例数 ÷ 用例总数。",
          "threshold": { "min": 50, "goodColor": "emerald", "badColor": "amber" } },
        { "key": "ai-defect-ratio",    "label": "AI生成用例发现缺陷占比", "unit": "%", "data_type": "percent",
          "description": "AI 生成用例发现缺陷数 / 全部用例发现缺陷数。" }
      ]},
      { "key": "capability", "label": "能力指标", "items": [
        { "key": "ai-cases-generated", "label": "AI生成用例数", "data_type": "int",
          "description": "AI 系统本月生成的全部候选用例（含未采纳）。" },
        { "key": "ai-cases-adopted",   "label": "AI生成采纳用例数", "data_type": "int",
          "description": "AI 生成且落入正式用例库的数量。" },
        { "key": "adoption-rate",      "label": "AI生成用例采纳率", "unit": "%", "data_type": "percent",
          "description": "AI 采纳用例数 ÷ AI 生成用例数。",
          "threshold": { "min": 65, "goodColor": "emerald", "badColor": "rose" } },
        { "key": "avg-interactions",   "label": "平均每需求交互次数", "data_type": "decimal",
          "description": "每个需求的 AI 平均交互轮数。" }
      ]}
    ]
  },

  "primary_view": {
    "enabled": true,
    "title": "试点进展明细",
    "endpoint": "/api/reports/codegen/summary",
    "method": "POST",
    "paging": { "default_mode": "client", "default_page_size": 10 },
    "tabs": [
      {
        "key": "industry",
        "label": "三大先锋产业试点进展",
        "data_endpoint": "/api/reports/codegen/summary?tab=industry",
        "header_tree": [
          { "key": "industry", "label": "产业",   "width": "100px", "filterable": true },
          { "key": "owner",    "label": "接口人", "width": "90px",  "filterable": true },
          { "key": "design", "label": "测试设计阶段", "children": [
            { "key": "design-coverage-count",      "label": "测试设计覆盖人数" },
            { "key": "design-landed-requirements", "label": "落地需求个数" },
            { "key": "design-adoption-rate",       "label": "用例采纳率", "sortable": true, "highlight": true,
              "threshold": { "min": 65, "goodColor": "emerald", "badColor": "rose" } },
            { "key": "design-new-ai-case-ratio",   "label": "新用例AI生成占比" }
          ]},
          { "key": "script", "label": "测试脚本生成阶段", "children": [
            { "key": "script-coverage-count",  "label": "测试脚本覆盖人数" },
            { "key": "script-code-volume",     "label": "生成代码量(k行)" },
            { "key": "script-accuracy",        "label": "生成代码准确率", "sortable": true,
              "threshold": { "min": 80, "goodColor": "emerald", "badColor": "amber" } },
            { "key": "script-new-ai-ratio",    "label": "新增脚本AI生成占比" },
            { "key": "script-efficiency-gain", "label": "阶段效率提升预估" }
          ]},
          { "key": "execution", "label": "测试执行阶段", "children": [
            { "key": "execution-accuracy",        "label": "测试执行准确率", "sortable": true, "highlight": true,
              "threshold": { "min": 90, "goodColor": "emerald", "badColor": "rose" } },
            { "key": "execution-result-accuracy", "label": "结果分析准确率", "sortable": true,
              "threshold": { "min": 85, "goodColor": "emerald", "badColor": "amber" } }
          ]},
          { "key": "actions", "label": "操作", "width": "120px", "cellType": "action" }
        ]
      },
      {
        "key": "domain",
        "label": "四大领域试点进展",
        "data_endpoint": "/api/reports/codegen/summary?tab=domain",
        "header_tree": [
          { "key": "domain", "label": "领域", "width": "120px", "filterable": true },
          { "key": "req", "label": "需求覆盖", "children": [
            { "key": "req-count",       "label": "需求个数" },
            { "key": "req-ai-count",    "label": "AI需求个数" },
            { "key": "req-ai-coverage", "label": "AI涉及需求覆盖率" },
            { "key": "req-new-cases",   "label": "新增用例个数" }
          ]},
          { "key": "case", "label": "用例生成", "children": [
            { "key": "case-ai-count",    "label": "AI用例个数" },
            { "key": "case-ai-ratio",    "label": "测试用例AI生成占比" },
            { "key": "case-ai-adoption", "label": "AI生成用例采纳率" }
          ]},
          { "key": "script", "label": "脚本生成", "children": [
            { "key": "script-ai-ratio",    "label": "AI生成脚本代码占比" },
            { "key": "script-ai-lines",    "label": "AI生成代码入库行数" },
            { "key": "script-ai-accuracy", "label": "AI生成代码准确率" }
          ]},
          { "key": "exec", "label": "测试执行", "children": [
            { "key": "exec-new-ai-ratio",     "label": "新增测试脚本AI辅助生成占比" },
            { "key": "exec-ai-ratio",         "label": "AI辅助测试执行比例" },
            { "key": "exec-intent-accuracy",  "label": "测试执行任务意图识别准确率" },
            { "key": "exec-fail-count",       "label": "自动化失败需分析数" },
            { "key": "exec-fail-ai-rate",     "label": "自动化失败AI自主分析率(S级)" },
            { "key": "exec-fail-ai-accuracy", "label": "自动化失败AI自主分析准确率(S级)" }
          ]},
          { "key": "actions", "label": "操作", "width": "120px", "cellType": "action" }
        ]
      }
    ]
  },

  "drilldowns": {}
}
