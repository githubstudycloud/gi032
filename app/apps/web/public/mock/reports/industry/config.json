{
  "meta": {
    "report_type": "industry",
    "name": "产业落地进展",
    "subtitle": "三大先锋产业的 AI 测试覆盖进展",
    "description": "本月各产业接入 AI 测试运营 / 设计 / 脚本生成的覆盖情况，按 业务日期 + 部门 聚合。",
    "version": 1,
    "user_pref_endpoint": "/api/users/me/columns/industry"
  },

  "toolbar": {
    "show_refresh":           true,
    "show_paging_mode":       false,
    "show_compare":           false,
    "show_column_customizer": false,
    "show_export":            false
  },

  "filters": [
    {
      "code":     "time_range",
      "label":    "时间范围",
      "kind":     "flat_dropdown",
      "required": true,
      "param":    { "value": "time_range" },
      "default":  { "value": "7d" },
      "source":   { "endpoint": "/dropdowns/time-ranges", "params_in": ["q"], "supports_favorite": false }
    },
    {
      "code":     "department",
      "label":    "部门",
      "kind":     "hierarchy_dropdown",
      "param":    { "value": "department_code" },
      "default":  { "value": "all" },
      "source":   { "endpoint": "/dropdowns/departments-tree", "params_in": ["q", "page", "page_size"], "supports_favorite": true, "max_levels": 2, "select_at_any_depth": true }
    }
  ],

  "kpi": {
    "enabled":             true,
    "title":               "核心指标",
    "data_endpoint":       "/api/reports/industry/kpi",
    "layout_mode_default": "grouped",
    "footnote":            "点击卡片可查看明细数字。",
    "groups": [
      {
        "key":   "user",
        "label": "用户指标",
        "items": [
          { "key": "ai-user-count", "label": "AI用户数",
            "unit": "", "data_type": "int",
            "description": "本月使用过 AI 测试运营任意功能的活跃用户数。\n口径：月内至少一次发起 AI 调用。\n环比：上月。" }
        ]
      },
      {
        "key":   "business",
        "label": "业务指标",
        "items": [
          { "key": "ai-requirements",    "label": "AI需求数",
            "data_type": "int",
            "description": "本月接入 AI 测试设计 / 脚本生成的需求总数。" },
          { "key": "total-requirements", "label": "需求数",
            "data_type": "int",
            "description": "本月所有进入测试环节的需求总数。" },
          { "key": "design-coverage",    "label": "AI测试设计需求覆盖率",
            "unit": "%", "data_type": "percent",
            "description": "公式：AI 需求数 ÷ 需求数 × 100%。\n反映 AI 能力在设计阶段的渗透广度。\n参考阈值：≥ 60% 为达标。",
            "threshold": { "min": 60, "goodColor": "emerald", "badColor": "rose" } },
          { "key": "valid-ai-cases",     "label": "AI生成的有效用例数", "data_type": "int",
            "description": "AI 生成且被采纳的用例总数。" },
          { "key": "total-cases",        "label": "用例数", "data_type": "int",
            "description": "本月新增的测试用例总数。" },
          { "key": "ai-case-ratio",      "label": "AI生成测试用例占比",
            "unit": "%", "data_type": "percent",
            "description": "公式：AI 生成有效用例数 ÷ 用例总数。\n反映 AI 对用例资产的贡献占比。",
            "threshold": { "min": 50, "goodColor": "emerald", "badColor": "amber" } },
          { "key": "ai-defect-ratio",    "label": "AI生成用例发现缺陷占比",
            "unit": "%", "data_type": "percent",
            "description": "AI 生成用例发现缺陷数 / 全部用例发现缺陷数。" }
        ]
      },
      {
        "key":   "capability",
        "label": "能力指标",
        "items": [
          { "key": "ai-cases-generated", "label": "AI生成用例数", "data_type": "int",
            "description": "AI 系统本月生成的全部候选用例（含未采纳）。" },
          { "key": "ai-cases-adopted",   "label": "AI生成采纳用例数", "data_type": "int",
            "description": "AI 生成且落入正式用例库的数量。" },
          { "key": "adoption-rate",      "label": "AI生成用例采纳率",
            "unit": "%", "data_type": "percent",
            "description": "公式：AI 采纳用例数 ÷ AI 生成用例数。\n下降可能源于模型质量或评审口径变化。",
            "threshold": { "min": 65, "goodColor": "emerald", "badColor": "rose" } },
          { "key": "avg-interactions",   "label": "平均每需求交互次数", "data_type": "decimal",
            "description": "每个需求的 AI 平均交互轮数。" }
        ]
      }
    ]
  },

  "primary_view": {
    "enabled":  true,
    "title":    "试点进展明细",
    "endpoint": "/api/reports/industry/summary",
    "method":   "POST",
    "paging":   { "default_mode": "client", "default_page_size": 10 },
    "row_dim_options": [ { "code": "industry", "label": "按产业 (默认)" } ],
    "row_dim_default": "industry",
    "row_favorite": {
      "enabled":         false,
      "toggle_endpoint": "/api/users/me/row_favorites/industry",
      "sort_on_top":     true
    },
    "tabs": [
      {
        "key":           "industry-detail",
        "label":         "产业试点进展明细",
        "data_endpoint": "/api/reports/industry/summary?tab=industry-detail",
        "header_tree_endpoint": null,
        "header_tree": [
          { "key": "industry", "label": "产业",                "width": "90px",  "filterable": true },
          { "key": "owner",    "label": "接口人",              "width": "80px",  "filterable": true },
          { "key": "e2e-eff",  "label": "端到端效率提升预估",  "width": "130px", "sortable": true },
          { "key": "sdv", "label": "SDV测试Agent", "children": [
            { "key": "sdv-design", "label": "测试设计Agent", "children": [
              { "key": "sdv-design-efficiency","label": "阶段效率提升预估", "sortable": true,
                "threshold": { "min": 20, "goodColor": "emerald", "badColor": "amber" } },
              { "key": "sdv-design-coverage", "label": "覆盖人数" },
              { "key": "sdv-design-landed",   "label": "落地需求个数" },
              { "key": "sdv-design-adoption", "label": "用例采纳率" },
              { "key": "sdv-design-new-ai",   "label": "新用例AI生成占比" }
            ]},
            { "key": "sdv-script", "label": "测试脚本Agent", "children": [
              { "key": "sdv-script-efficiency", "label": "阶段效率提升预估" },
              { "key": "sdv-script-coverage",   "label": "覆盖人数" },
              { "key": "sdv-script-volume",     "label": "生成代码量(k行)" },
              { "key": "sdv-script-accuracy",   "label": "生成代码准确率" }
            ]},
            { "key": "sdv-exec", "label": "测试执行Agent" },
            { "key": "sdv-result", "label": "结果分析Agent", "children": [
              { "key": "sdv-result-accuracy", "label": "结果分析准确率" },
              { "key": "sdv-result-users",    "label": "使用人数" }
            ]},
            { "key": "sdv-api", "label": "API E2E测试", "children": [
              { "key": "sdv-api-volume",   "label": "代码量" },
              { "key": "sdv-api-accuracy", "label": "生成代码准确率" }
            ]},
            { "key": "sdv-aifeature", "label": "AI特性E2E测试", "children": [
              { "key": "sdv-aifeature-new",  "label": "新增脚本AI生成占比" },
              { "key": "sdv-aifeature-half", "label": "50%由AI测试" }
            ]}
          ]},
          { "key": "e2e", "label": "E2E测试", "children": [
            { "key": "e2e-third", "label": "三方应用E2E测试", "children": [
              { "key": "e2e-third-core",   "label": "核心路径智能执行比例90%" },
              { "key": "e2e-third-recall", "label": "准召率90%" },
              { "key": "e2e-third-reduce", "label": "减少30%的修改引入问题" }
            ]},
            { "key": "e2e-precise", "label": "精准测试", "children": [
              { "key": "e2e-precise-detect", "label": "AI检测占比60%" },
              { "key": "e2e-precise-recall", "label": "准召率90%" }
            ]},
            { "key": "e2e-doc", "label": "资料测试", "children": [
              { "key": "e2e-doc-top5", "label": "红线top5" }
            ]},
            { "key": "e2e-security", "label": "安全测试", "children": [
              { "key": "e2e-security-nss", "label": "开发者NSS牵引50%" }
            ]},
            { "key": "e2e-testing", "label": "Testing" }
          ]},
          { "key": "special", "label": "专项测试", "width": "100px" },
          { "key": "tools",   "label": "外部工具", "width": "100px" },
          { "key": "actions", "label": "操作",     "width": "90px", "cellType": "action" }
        ]
      },
      {
        "key":   "capability-map",
        "label": "产业人员能力地图",
        "data_endpoint": "/api/reports/industry/summary?tab=capability-map",
        "header_tree_endpoint": null,
        "header_tree": [
          { "key": "industry", "label": "产业",   "width": "100px" },
          { "key": "owner",    "label": "接口人", "width": "90px"  },
          { "key": "hw", "label": "HW", "children": [
            { "key": "hw-total",     "label": "总人数" },
            { "key": "hw-gold-dev",  "label": "AI金种子(Agent/skill开发)" },
            { "key": "hw-gold-user", "label": "AI金种子(先锋试点用户)" }
          ]},
          { "key": "od", "label": "OD", "children": [
            { "key": "od-rate",     "label": "AI渗透率" },
            { "key": "od-total",    "label": "总人数" },
            { "key": "od-gold-dev", "label": "AI金种子(Agent/skill开发)" }
          ]},
          { "key": "tm", "label": "TM", "children": [
            { "key": "tm-gold-kb",   "label": "AI金种子(知识库构建)" },
            { "key": "tm-gold-user", "label": "AI金种子(先锋试点用户)" },
            { "key": "tm-rate",      "label": "AI渗透率" }
          ]}
        ]
      }
    ]
  },

  "drilldowns": {
    "industry-row-detail": {
      "title": "产业明细 — {row.industry}",
      "endpoint": "/api/reports/industry/detail",
      "method":   "POST",
      "param_mapping": {
        "row.industry":  "industry",
        "filter.time_range":"time_range",
        "cell.column":   "metric"
      },
      "paging": { "default_page_size": 50 },
      "header_tree_endpoint": null,
      "header_tree": [
        { "key": "metric_code",  "label": "指标"   },
        { "key": "metric_value", "label": "数值"   },
        { "key": "updated_at",   "label": "采集时间" }
      ]
    }
  }
}
