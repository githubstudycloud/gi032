{
  "meta": {
    "report_type": "result",
    "name": "AI辅助结果分析",
    "subtitle": "各部门 AI 结果分析能力排行",
    "version": 1,
    "user_pref_endpoint": "/api/users/me/columns/result"
  },

  "toolbar": { "show_refresh": true },

  "filters": [
    { "code": "time_range", "label": "时间范围", "kind": "flat_dropdown", "required": true,
      "param": { "value": "time_range" }, "default": { "value": "7d" },
      "source": { "endpoint": "/dropdowns/time-ranges", "params_in": ["q"] } },
    { "code": "department", "label": "领域", "kind": "flat_dropdown",
      "param": { "value": "department_code" }, "default": { "value": "all" },
      "source": { "endpoint": "/dropdowns/departments", "params_in": ["q", "page"], "supports_favorite": true } }
  ],

  "kpi": {
    "enabled": true,
    "title": "核心指标",
    "data_endpoint": "/api/reports/result/kpi",
    "layout_mode_default": "grouped",
    "footnote": "点击卡片可查看明细数字。",
    "groups": [
      { "key": "user", "label": "用户指标", "items": [
        { "key": "ai-user-count", "label": "AI用户数", "data_type": "int",
          "description": "本月使用过 AI 结果分析功能的活跃用户数。" }
      ]},
      { "key": "business", "label": "业务指标", "items": [
        { "key": "ai-requirements",    "label": "AI分析需求数", "data_type": "int",
          "description": "本月接入 AI 结果分析的需求总数。" },
        { "key": "total-requirements", "label": "需求数",   "data_type": "int",
          "description": "本月所有进入测试环节的需求总数。" },
        { "key": "design-coverage",    "label": "AI结果分析覆盖率", "unit": "%", "data_type": "percent",
          "description": "公式：AI 分析需求数 ÷ 需求数 × 100%。\n参考阈值：≥ 50% 为达标。",
          "threshold": { "min": 50, "goodColor": "emerald", "badColor": "rose" } },
        { "key": "valid-ai-cases",     "label": "AI分析准确用例数", "data_type": "int",
          "description": "AI 分析结果被人工确认为正确的用例数。" },
        { "key": "total-cases",        "label": "分析用例数", "data_type": "int",
          "description": "本月被 AI 处理的测试用例总数。" },
        { "key": "ai-case-ratio",      "label": "AI分析覆盖占比", "unit": "%", "data_type": "percent",
          "description": "AI 分析准确用例数 / 分析用例总数。",
          "threshold": { "min": 70, "goodColor": "emerald", "badColor": "amber" } },
        { "key": "ai-defect-ratio",    "label": "AI定位缺陷占比", "unit": "%", "data_type": "percent",
          "description": "AI 自主定位缺陷数 / 全部缺陷数。" }
      ]},
      { "key": "capability", "label": "能力指标", "items": [
        { "key": "ai-cases-generated", "label": "AI分析总数", "data_type": "int",
          "description": "AI 本月触发的分析任务总数。" },
        { "key": "ai-cases-adopted",   "label": "AI分析采纳数", "data_type": "int",
          "description": "AI 分析结论被人工确认采纳的任务数。" },
        { "key": "adoption-rate",      "label": "AI分析准确率", "unit": "%", "data_type": "percent",
          "description": "公式：AI 分析采纳数 ÷ AI 分析总数。",
          "threshold": { "min": 80, "goodColor": "emerald", "badColor": "rose" } },
        { "key": "avg-interactions",   "label": "平均每分析交互次数", "data_type": "decimal",
          "description": "每次分析任务的 AI 平均交互轮数。" }
      ]}
    ]
  },

  "primary_view": {
    "enabled": true,
    "title": "AI辅助结果分析明细",
    "endpoint": "/api/reports/result/summary",
    "method": "POST",
    "paging": { "default_mode": "client", "default_page_size": 10 },
    "tabs": [
      {
        "key": "result-detail",
        "label": "AI辅助结果分析明细",
        "data_endpoint": "/api/reports/result/summary?tab=result-detail",
        "header_tree": [
          { "key": "rank",          "label": "排名",         "width": "70px",  "sortable": true },
          { "key": "department",    "label": "部门",         "width": "200px", "filterable": true, "align": "left" },
          { "key": "req-total",     "label": "需求总数",     "sortable": true },
          { "key": "ai-req-count",  "label": "Ai分析需求数", "sortable": true },
          { "key": "coverage",      "label": "分析覆盖率",   "sortable": true, "highlight": true,
            "threshold": { "min": 50, "goodColor": "emerald", "badColor": "rose" } },
          { "key": "ai-cases",      "label": "Ai分析数",     "sortable": true },
          { "key": "adopted-cases", "label": "采纳数",       "sortable": true },
          { "key": "adoption-rate", "label": "采纳率",       "sortable": true, "highlight": true,
            "threshold": { "min": 80, "goodColor": "emerald", "badColor": "amber" } },
          { "key": "defects",       "label": "定位缺陷数",   "sortable": true },
          { "key": "actions",       "label": "操作",         "width": "90px", "cellType": "action" }
        ]
      }
    ]
  },

  "drilldowns": {}
}
