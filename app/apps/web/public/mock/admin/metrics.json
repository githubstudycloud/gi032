        "options": [
          { "value": "用户指标", "label": "用户指标" },
          { "value": "业务指标", "label": "业务指标" },
          { "value": "能力指标", "label": "能力指标" }
        ] },
      { "code": "status", "label": "状态", "kind": "enum_chips",
        "options": [
          { "value": "active",     "label": "启用" },
          { "value": "draft",      "label": "草稿" },
          { "value": "deprecated", "label": "废弃" }
        ] }
    ],
    "columns": [
      { "code": "id",        "label": "指标 ID",  "width": "200px" },
      { "code": "name",      "label": "指标名称", "width": "220px" },
      { "code": "category",  "label": "分类",     "width": "100px",
