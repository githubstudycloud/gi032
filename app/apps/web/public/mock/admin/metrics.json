      { "code": "source",    "label": "数据源",   "width": "150px" },
      { "code": "status",    "label": "状态",     "width": "90px",
        "display": { "kind": "badge",
                     "color_map": { "active": "emerald", "draft": "amber", "deprecated": "rose" } } },
      { "code": "owner",     "label": "负责人",   "width": "90px" },
      { "code": "updated_at","label": "更新时间", "width": "160px",
        "display": { "kind": "datetime" } },
      { "code": "actions",   "label": "操作",     "width": "130px",
        "cellType": "row_actions", "actions": ["edit", "delete"] }
    ],
    "form_fields": [
      { "code": "id",   "label": "指标 ID", "kind": "text", "required": true, "readonly_on_edit": true,
        "placeholder": "kebab-case，如 ai-user-count",
        "help": "新增后不可修改；其它报表的 KPI 卡通过这个 ID 引用本指标。" },
      { "code": "name", "label": "指标名称", "kind": "text", "required": true },
      { "code": "category", "label": "分类", "kind": "enum_radio", "required": true,
        "options": [
          { "value": "用户指标", "label": "用户指标" },
          { "value": "业务指标", "label": "业务指标" },
          { "value": "能力指标", "label": "能力指标" }
        ]},
      { "code": "source", "label": "数据源", "kind": "text" },
      { "code": "status", "label": "状态", "kind": "enum_radio", "default": "active",
        "options": [
          { "value": "active",     "label": "启用" },
          { "value": "draft",      "label": "草稿" },
          { "value": "deprecated", "label": "废弃" }
        ]},
      { "code": "owner", "label": "负责人", "kind": "text" },
      { "code": "description", "label": "口径描述", "kind": "textarea", "rows": 3 },
      { "code": "unit", "label": "单位", "kind": "text", "placeholder": "%, 个, 行 ..." },
      { "code": "data_type", "label": "数据类型", "kind": "enum_radio", "default": "decimal",
        "options": [
          { "value": "int",     "label": "整数" },
          { "value": "decimal", "label": "小数" },
          { "value": "percent", "label": "百分比" }
        ]},
      { "code": "aggregation", "label": "聚合方式", "kind": "enum_radio", "default": "sum",
        "options": [
          { "value": "sum",          "label": "求和" },
          { "value": "avg",          "label": "均值" },
          { "value": "weighted_avg", "label": "加权均值" },
          { "value": "computed",     "label": "公式" }
        ]}
    ]
  },

